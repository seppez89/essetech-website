{
  "redirects": [
    {
      "source": "/ai-implementation-adelaide.html",
      "destination": "/secure-ai-enablement-adelaide.html",
      "permanent": true
    },
    {
      "source": "/ai-implementation-adelaide",
      "destination": "/secure-ai-enablement-adelaide.html",
      "permanent": true
    },
    {
      "source": "/website-care.html",
      "destination": "/web-design-adelaide.html",
      "permanent": true
    },
    {
      "source": "/website-care",
      "destination": "/web-design-adelaide.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico|mp4|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/tailwind.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
